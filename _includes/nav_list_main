<!-- {% assign sum = site.posts | size %}
{% assign temp_count = site.posts | where: "categories", "temp" | size %}
{% assign total = sum | minus: temp_count %} -->

{% assign filtered_posts = "" | split: "" %}
{% for post in site.posts %}
  {% unless post.categories contains "temp" or post.categories contains "projects" %}
    {% assign filtered_posts = filtered_posts | push: post %}
  {% endunless %}
{% endfor %}
{% assign total = filtered_posts | size %}

