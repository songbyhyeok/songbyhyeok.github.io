            <span id="nav__sub-total" style="font-family:'Cafe24Oneprettynight';">total</style> 
                <span style="font-family:'Coming Soon';">
                    {{total}} </style> 
                    <span style="font-family:'Cafe24Oneprettynight';">posts</style>
        </li>
        <li>
            <span class="nav__sub-title" onclick="toggle('blogSubMenu')">cs</span>
            <ul id="blogSubMenu" style="display: none;">
