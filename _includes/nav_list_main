{% assign sum = site.posts | size %}

<nav class="nav__list">
    <input id="ac-toc" name="accordion-toc" type="checkbox" />
    <label for="ac-toc">{{ site.data.ui-text[site.locale].menu_label }}</label>
    <ul class="nav__items" id="category_tag_menu">
        <li>
            📂 <span id="nav__sub-total" style="font-family:'Cafe24Oneprettynight';">Total</style> <span
                    style="font-family:'Coming Soon';">{{sum}}</style> <span
                        style="font-family:'Cafe24Oneprettynight';">posts</style>
        </li>

        <li>
            <span class="nav__sub-title">Framework</span>
            <ul>
                {% for category in site.categories %}
                {% if category[0] == "spring" %}
                <li><a href="/categories/spring" id="nav__sub-item">Spring ({{category[1].size}})</a></li>
                {% endif %}
                {% endfor %}
            </ul>
        </li>

        <li>
            <span class="nav__sub-title">CS</span>
            <ul>
                {% for category in site.categories %}
                {% if category[0] == "network" %}
                <li><a href="/categories/network" id="nav__sub-item">Network ({{category[1].size}})</a></li>
                {% endif %}
                {% endfor %}
            </ul>
        </li>

        <li>
            <span class="nav__sub-title">Etc</span>
            <ul>
                {% for category in site.categories %}
                {% if category[0] == "aws" %}
                <li><a href="/categories/aws" id="nav__sub-item">AWS ({{category[1].size}})</a></li>
                {% endif %}
                {% endfor %}
            </ul>
            <ul>
                {% for category in site.categories %}
                {% if category[0] == "github_actions" %}
                <li><a href="/categories/github_actions" id="nav__sub-item">GithubActions ({{category[1].size}})</a></li>
                {% endif %}
                {% endfor %}
            </ul>
            <ul>
                {% for category in site.categories %}
                {% if category[0] == "github" %}
                <li><a href="/categories/github" id="nav__sub-item">Github ({{category[1].size}})</a></li>
                {% endif %}
                {% endfor %}
            </ul>
        </li>

    </ul>
</nav>